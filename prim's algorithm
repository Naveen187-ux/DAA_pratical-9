
#include <iostream>
using namespace std;

int main() {
    int n = 5;

    int cost[5][5] = {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    int selected[5] = {0};
    selected[0] = 1;

    int edges = 0, total = 0;

    cout << "Edge\tWeight\n";

    while (edges < n - 1) {
        int min = 999999;
        int x = -1, y = -1;

        for (int i = 0; i < n; i++) {
            if (selected[i]) {
                for (int j = 0; j < n; j++) {
                    if (!selected[j] &&
                        cost[i][j] != 0 &&
                        cost[i][j] < min) {
                        min = cost[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        if (x == -1) {
            cout << "Graph is disconnected";
            return 0;
        }

        cout << x << " - " << y
             << "\t" << min << endl;

        selected[y] = 1;
        total += min;
        edges++;
    }

    cout << "Minimum cost = " << total;

    return 0;
}
